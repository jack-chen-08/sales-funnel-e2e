# 复制为 .env 后再启动环境；所有值仅通过环境变量注入，不写死在代码里
POSTGRES_USER=smoke
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=smoke
PG_PORT=55433

# 冒烟平台服务
SMOKE_PLATFORM_PORT=5600
DATABASE_URL=postgresql+psycopg://smoke:change-me-local-only@127.0.0.1:55433/smoke

# 电子签桩模式：ok（正常两方签署）| reject（模拟签约方拒签，用于失败路径演示）
SIGN_STUB_MODE=ok
# 小程序桩模式：ok | error
MINIAPP_STUB_MODE=ok

# 组织与站点标识（虚构）
SMOKE_ORG_ID=6f1c2b40-0000-4000-8000-000000000001
SMOKE_SITE_ID=6f1c2b40-0000-4000-8000-0000000000a1

# 测试侧
SMOKE_BASE_URL=http://127.0.0.1:5600
SMOKE_HEADLESS=1
