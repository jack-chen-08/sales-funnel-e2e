.entry {
  padding: 24rpx;
  background: #f5f7fa;
}

.hd {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 8rpx 4rpx 20rpx;
}

.brand {
  font-size: 36rpx;
  font-weight: 600;
  color: #1b1f24;
}

.subtle {
  font-size: 24rpx;
  color: #6b7280;
}

.phase {
  margin: 0 4rpx 16rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.who {
  margin: 0 4rpx 16rpx;
  font-size: 24rpx;
  color: #1b1f24;
}

.who-label {
  color: #6b7280;
  margin-right: 8rpx;
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(24, 39, 75, 0.06);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1b1f24;
  margin-bottom: 16rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.field-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.field-value,
.phone-value {
  font-size: 28rpx;
  color: #1b1f24;
}

.code-input {
  flex: 1;
  font-size: 28rpx;
  padding: 8rpx 0;
}

.btn {
  margin-top: 24rpx;
  background: #1f6feb;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn::after {
  border: none;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.k {
  color: #6b7280;
}

.v {
  color: #1b1f24;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.item-name {
  color: #1b1f24;
}

.item-quota {
  color: #1f6feb;
}

.month {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.item-count {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.error {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #c0392b;
}

.evlog {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #eef4ff;
  border-radius: 12rpx;
}

.evlog-title {
  display: block;
  font-size: 22rpx;
  color: #1f6feb;
  margin-bottom: 8rpx;
}

.evlog-item {
  display: block;
  font-size: 22rpx;
  color: #4b5563;
  line-height: 1.6;
}
