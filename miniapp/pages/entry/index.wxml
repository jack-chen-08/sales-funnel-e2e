<!--
  会员入会入口页：承载 member-entry 组件，并在认证成功后真实跳转首页。
  真机进入方式（模拟链路第 11 步起点）：
    /pages/entry/index?member_id=<会员ID>&run_id=<本次冒烟 run_id>
  两个参数均由平台侧「会员经理领取交接」后的会员档案提供。
-->
<view class="entry-page">
  <view class="page-meta">
    <text class="page-path">pages/entry/index</text>
    <text class="page-phase" data-phase="{{phase}}">页面阶段：{{phaseLabel}}</text>
  </view>

  <member-entry
    base-url="{{baseUrl}}"
    member-id="{{memberId}}"
    run-id="{{runId}}"
    phone="{{phone}}"
    company="{{company}}"
    contact="{{contact}}"
    bind:certified="onCertified"
    bind:home-ready="onHomeReady"
    bind:failed="onFailed"
  />

  <view class="error page-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>

  <view class="evlog page-evlog" wx:if="{{events.length}}">
    <text class="evlog-title">页面事件（{{events.length}}）</text>
    <text class="evlog-item" wx:for="{{events}}" wx:key="seq">{{item.seq}}.{{item.name}}</text>
  </view>
</view>
